rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNÇÕES AUXILIARES DE SEGURANÇA E AUTORIZAÇÃO (RBAC)
    // =========================================================================

    /// Verifica se a requisição provém de um usuário devidamente autenticado
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /// Retorna os dados do documento do usuário autenticado na coleção 'usuarios'
    function currentUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    /// Retorna o papel (role) do usuário autenticado no sistema
    function currentUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? currentUserData().role
        : null;
    }

    /// Verifica se o usuário atual possui privilégios de administrador
    function isAdmin() {
      return currentUserRole() == 'admin' || currentUserRole() == 'administrador';
    }

    /// Verifica se o usuário atual é motorista credenciado
    function isMotorista() {
      return currentUserRole() == 'motorista';
    }

    /// Verifica se o documento sob consulta/edição pertence ao próprio usuário logado
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // VALIDADORES DE ESQUEMA E DADOS (DEFESA EM PROFUNDIDADE)
    // =========================================================================

    /// Valida campos comuns e obrigatórios para qualquer tipo de pessoa
    function isValidPessoaBase(dados) {
      return dados.nome is string && dados.nome.size() >= 3 && dados.nome.size() <= 120
          && dados.cpf is string && dados.cpf.size() >= 11 && dados.cpf.size() <= 14
          && dados.telefone is string
          && dados.role in ['paciente', 'motorista', 'admin', 'administrador']
          && (!('ativo' in dados) || dados.ativo is bool);
    }

    /// Valida integridade e imutabilidade na criação (Create)
    function isValidPessoaCreate(dados) {
      return isValidPessoaBase(dados)
          && (!('criadoEm' in dados) || dados.criadoEm == request.time);
    }

    /// Valida integridade e imutabilidade na atualização (Update)
    function isValidPessoaUpdate(novoDado, dadoAtual) {
      return isValidPessoaBase(novoDado)
          // Impede alteração retroativa da data de cadastro quando existente
          && (!('criadoEm' in dadoAtual) || novoDado.criadoEm == dadoAtual.criadoEm)
          // Garante sincronismo temporal quando atualizadoEm é enviado
          && (!('atualizadoEm' in novoDado) || novoDado.atualizadoEm == request.time)
          // Apenas administradores podem alterar o papel de uma pessoa
          && (novoDado.role == dadoAtual.role || isAdmin() || !isAuthenticated());
    }

    // =========================================================================
    // COLEÇÃO: USUARIOS (PESSOAS: PACIENTES, MOTORISTAS, ADMINS)
    // =========================================================================
    match /usuarios/{userId} {
      
      // LEITURA:
      // - Em produção autenticada: Administradores lêem tudo; Motoristas lêem pacientes/motoristas; Pacientes lêem a si mesmos.
      // - Em ambiente de desenvolvimento/apresentação (sem login ativo): permite leitura das telas.
      allow read: if isAdmin()
                  || (isMotorista() && (resource.data.role == 'paciente' || resource.data.role == 'motorista'))
                  || isOwner(userId)
                  || !isAuthenticated();

      // CRIAÇÃO:
      // Permite criação por administradores ou durante o desenvolvimento
      allow create: if (isAdmin() || !isAuthenticated())
                    && isValidPessoaCreate(request.resource.data);

      // ATUALIZAÇÃO (inclusive Soft Delete com ativo: false):
      // Permite atualização por administradores, titular ou desenvolvimento
      allow update: if (isAdmin() || isOwner(userId) || !isAuthenticated())
                    && isValidPessoaUpdate(request.resource.data, resource.data);

      // EXCLUSÃO FÍSICA: TERMINANTEMENTE PROIBIDA (LGPD & AUDITORIA SUS)
      // Todo desligamento de registro deve ser estritamente lógico através de `ativo: false`.
      // Isso protege a integridade referencial de viagens realizadas e relatórios legais.
      allow delete: if false;
    }

    // =========================================================================
    // COLEÇÃO: VIAGENS
    // =========================================================================
    match /viagens/{viagemId} {
      allow read: if isAuthenticated() || !isAuthenticated();
      allow create: if isMotorista() || isAdmin() || !isAuthenticated();
      allow update: if isMotorista() || isAdmin() || !isAuthenticated();
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // =========================================================================
    // COLEÇÃO: VEÍCULOS
    // =========================================================================
    match /veiculos/{veiculoId} {
      allow read: if isAuthenticated() || !isAuthenticated();
      allow write: if isAdmin() || !isAuthenticated();
    }
  }
}
